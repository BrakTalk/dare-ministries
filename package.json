    "@netlify/database-dev": "^0.10.1",
    "dotenv": "^17.3.1",
    "happy-dom": "^20.11.0",
    "prettier": "^3.8.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@netlify/blobs": "^10.7.9",
    "@netlify/database": "^1.1.0",
    "@netlify/functions": "^5.3.0",
    "@netlify/identity": "^1.2.0",
    "exifr": "^7.1.3",
    "luxon": "^3.7.2",
    "markdown-it": "^14.3.0",
    "resend": "^6.22.1",
    "sharp": "^0.35.3"
  }
