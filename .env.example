# Netlify supplies URL, DEPLOY_PRIME_URL, CONTEXT, and NETLIFY_DATABASE_URL.
# Do not copy production secrets into this file.

# Existing site notifications and Field Note rebuilds
RESEND_API_KEY=re_replace_with_resend_api_key
NOTIFY_EMAIL=coordinator@example.org
NOTIFY_FROM=D.A.R.E. Ministries <notifications@example.org>
BUILD_HOOK_URL=https://api.netlify.com/build_hooks/replace_me

# Emailed Field Photo Inbox
# Use one or more exact recipient addresses, separated by commas.
FIELD_PHOTO_INBOX_RECIPIENTS=photos@inbound.whofixedtheroof.com

# Optional exact sender allowlist. Leave unset to accept any sender into the
# private moderation queue; nothing becomes public without coordinator approval.
FIELD_PHOTO_ALLOWED_SENDERS=trusted.volunteer@example.org

# Copy the signing secret from the Resend webhook configured for email.received.
RESEND_WEBHOOK_SECRET=whsec_replace_with_webhook_signing_secret

# Unreviewed photos and precise GPS metadata expire after this many days (1-365).
FIELD_PHOTO_INBOX_RETENTION_DAYS=30

# HEIC/HEIF remains fail-closed until the packaged Linux decoder has passed a
# deploy-preview self-test. Set to true only after following PHOTO_INBOX_SETUP.md.
FIELD_PHOTO_HEIC_ENABLED=false
