<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Choose a New Password | D.A.R.E. Volunteer Portal</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Merriweather:wght@400;700;900&family=Open+Sans:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="/css/portal.css" />
  </head>
  <body class="account-body">
    <header class="account-header">
      <a href="/" class="nav-logo" aria-label="D.A.R.E. Ministries home">
        <span class="logo-dare">D.A.R.E.</span>
        <span class="logo-sub">Volunteer Portal</span>
      </a>
    </header>

    <main class="account-main">
      <div class="account-layout">
        <section class="account-intro" aria-labelledby="new-password-heading">
          <p class="account-eyebrow">Account help</p>
          <h1 id="new-password-heading">Choose a new password</h1>
          <p>
            Use a password that is unique to this account and difficult for someone else to guess.
          </p>
        </section>
        <section class="account-card">
          <h2>New password</h2>
          <p>This form is available after you open the secure link in your reset email.</p>
          <form id="resetPasswordForm" class="account-form">
            <div class="form-group">
              <label for="newPassword">New password</label>
              <input
                type="password"
                id="newPassword"
                name="password"
                autocomplete="new-password"
                minlength="10"
                required
              />
            </div>
            <div class="form-group">
              <label for="newPasswordConfirm">Confirm new password</label>
              <input
                type="password"
                id="newPasswordConfirm"
                name="password_confirm"
                autocomplete="new-password"
                minlength="10"
                required
              />
            </div>
            <p id="accountStatus" class="account-status" role="status" aria-live="polite"></p>
            <button type="submit" class="btn btn-primary btn-full">Save New Password</button>
          </form>
        </section>
      </div>
    </main>

    {% include "identity-importmap.njk" %}
    <script type="module" src="/js/auth-client.js"></script>
  </body>
</html>
