---
layout: false
eleventyExcludeFromCollections: true
pagination:
  data: fieldNotes
  size: 1
  alias: note
permalink: "/field-notes/{{ note.slug }}/index.html"
---
{% from "head.njk" import head %}
{% set excerpt = note.body | markdown | striptags | truncate(160) %}
<!DOCTYPE html>
<html lang="en">
<head>
  {{ head(note.title + " — From the Field — " + site.title, excerpt) }}
  <meta property="og:type" content="article">
  <meta property="og:title" content="{{ note.title }}">
  <meta property="og:description" content="{{ excerpt }}">
  <meta property="og:url" content="{{ site.url }}/field-notes/{{ note.slug }}/">
  {% if note.cover %}
  <meta property="og:image" content="{{ site.url }}{{ note.cover.url }}">
  {% endif %}
</head>
<body>

  {% include "navbar.njk" %}

  <header class="page-hero">
    <div class="container">
      <p class="field-note-crumb"><a href="/field-notes/">&larr; From the Field</a></p>
      <h1>{{ note.title }}</h1>
      <time class="page-hero-subtitle">{{ note.date_display }}</time>
    </div>
  </header>

  <article class="section field-note">
    <div class="container">
      <div class="field-note-body">
        {{ note.body | markdown | safe }}
      </div>

      {% if note.photos.length %}
      <div class="field-gallery">
        {% for photo in note.photos %}
        <figure class="field-gallery-item">
          <button type="button" class="field-gallery-trigger" data-photo-index="{{ loop.index0 }}" aria-label="{% if photo.alt %}View full size: {{ photo.alt | escape }}{% else %}View full-size field note photo {{ loop.index }}{% endif %}">
            <img src="{{ photo.url }}" alt="{{ photo.alt | escape }}" loading="lazy">
          </button>
          {% if photo.alt %}
          <figcaption>{{ photo.alt | escape }}</figcaption>
          {% endif %}
        </figure>
        {% endfor %}
      </div>

      <dialog id="fieldPhotoDialog" class="field-photo-dialog" aria-label="Full-size field note photo">
        <div class="field-photo-frame">
          <div class="field-photo-stage">
            <button type="button" id="fieldPhotoClose" class="field-photo-close" aria-label="Close full-size photo">&times;</button>
            <button type="button" id="fieldPhotoPrevious" class="field-photo-page field-photo-page--previous" aria-label="Previous photo">&#8249;</button>
            <img id="fieldPhotoImage" class="field-photo-image" alt="">
            <button type="button" id="fieldPhotoNext" class="field-photo-page field-photo-page--next" aria-label="Next photo">&#8250;</button>
          </div>
          <p id="fieldPhotoCaption" class="field-photo-caption" hidden></p>
          <p id="fieldPhotoPosition" class="field-photo-position" aria-live="polite" hidden></p>
        </div>
      </dialog>
      {% endif %}

      <div class="field-note-footer">
        <a href="/field-notes/" class="btn btn-outline">&larr; All Field Notes</a>
      </div>
    </div>
  </article>

  {% include "footer.njk" %}

  <script src="/js/main.js"></script>
  <script src="/js/field-note-gallery.js"></script>
</body>
</html>
