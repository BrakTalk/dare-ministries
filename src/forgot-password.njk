<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Reset Password | D.A.R.E. Volunteer Portal</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Merriweather:wght@400;700;900&family=Open+Sans:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="/css/portal.css" />
  </head>
  <body class="account-body">
    <header class="account-header">
      <a href="/" class="nav-logo" aria-label="D.A.R.E. Ministries home">
        <span class="logo-dare">D.A.R.E.</span>
        <span class="logo-sub">Volunteer Portal</span>
      </a>
      <a href="/login/" class="btn btn-outline btn-small">Back to Sign In</a>
    </header>

    <main class="account-main">
      <div class="account-layout">
        <section class="account-intro" aria-labelledby="recovery-heading">
          <p class="account-eyebrow">Account help</p>
          <h1 id="recovery-heading">Reset your password</h1>
          <p>
            Enter the email address connected to your account. If the address is registered, you
            will receive a secure reset link.
          </p>
        </section>
        <section class="account-card">
          <h2>Send reset email</h2>
          <p>The link in the email will bring you back to this website.</p>
          <form id="forgotPasswordForm" class="account-form">
            <div class="form-group">
              <label for="recoveryEmail">Email address</label>
              <input type="email" id="recoveryEmail" name="email" autocomplete="email" required />
            </div>
            <p id="accountStatus" class="account-status" role="status" aria-live="polite"></p>
            <button type="submit" class="btn btn-primary btn-full">Send Reset Email</button>
          </form>
        </section>
      </div>
    </main>

    {% include "identity-importmap.njk" %}
    <script type="module" src="/js/auth-client.js"></script>
  </body>
</html>
