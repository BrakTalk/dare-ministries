<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Create an Account | D.A.R.E. Volunteer Portal</title>
    <meta
      name="description"
      content="Request access to the D.A.R.E. Ministries Volunteer Portal."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Merriweather:wght@400;700;900&family=Open+Sans:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="/css/portal.css" />
  </head>
  <body class="account-body">
    <header class="account-header">
      <a href="/" class="nav-logo" aria-label="D.A.R.E. Ministries home">
        <span class="logo-dare">D.A.R.E.</span>
        <span class="logo-sub">Volunteer Portal</span>
      </a>
      <div class="account-header-actions">
        <a href="/" class="btn btn-outline btn-small">Public Website</a>
      </div>
    </header>

    <main class="account-main">
      <div class="account-layout">
        <section class="account-intro" aria-labelledby="register-heading">
          <p class="account-eyebrow">Request access</p>
          <h1 id="register-heading">Create your account</h1>
          <p>
            Anyone may create a profile. A ministry coordinator reviews each request before private
            tools become available.
          </p>
          <ol class="account-steps">
            <li>
              <span class="account-step-number">1</span
              ><span>Create your profile and tell us how you are connected to D.A.R.E.</span>
            </li>
            <li>
              <span class="account-step-number">2</span
              ><span>Open the confirmation email to verify your address.</span>
            </li>
            <li>
              <span class="account-step-number">3</span
              ><span
                >A coordinator reviews your request. Sign in anytime to check your approval
                status.</span
              >
            </li>
          </ol>
        </section>

        <section class="account-card" aria-labelledby="register-form-heading">
          <h2 id="register-form-heading">Your profile</h2>
          <p>This information helps the ministry recognize and approve your request.</p>
          <form id="registerForm" class="account-form">
            <div class="form-group">
              <label for="registerName">Full name</label>
              <input
                type="text"
                id="registerName"
                name="full_name"
                autocomplete="name"
                maxlength="200"
                required
              />
            </div>
            <div class="form-group">
              <label for="registerEmail">Email address</label>
              <input
                type="email"
                id="registerEmail"
                name="email"
                autocomplete="email"
                maxlength="320"
                required
              />
            </div>
            <div class="form-group">
              <label for="registerPhone"
                >Phone number <span class="account-form-help">(optional)</span></label
              >
              <input type="tel" id="registerPhone" name="phone" autocomplete="tel" maxlength="50" />
            </div>
            <div class="form-group">
              <label for="registerOrganization"
                >Church or organization <span class="account-form-help">(optional)</span></label
              >
              <input
                type="text"
                id="registerOrganization"
                name="organization"
                autocomplete="organization"
                maxlength="200"
              />
            </div>
            <div class="form-group">
              <label for="registerReason">How are you connected to D.A.R.E.?</label>
              <textarea
                id="registerReason"
                name="request_reason"
                rows="4"
                maxlength="2000"
                placeholder="For example: I volunteered on the Augusta deployment with Roswell UMC."
                required
              ></textarea>
            </div>
            <div class="form-group">
              <label for="registerPassword">Password</label>
              <input
                type="password"
                id="registerPassword"
                name="password"
                autocomplete="new-password"
                minlength="10"
                required
              />
              <p class="account-form-help">
                Use at least 10 characters and avoid reusing a password from another website.
              </p>
            </div>
            <div class="form-group">
              <label for="registerPasswordConfirm">Confirm password</label>
              <input
                type="password"
                id="registerPasswordConfirm"
                name="password_confirm"
                autocomplete="new-password"
                minlength="10"
                required
              />
            </div>
            <p id="accountStatus" class="account-status" role="status" aria-live="polite"></p>
            <button type="submit" class="btn btn-primary btn-full">Create Account</button>
          </form>
          <div class="account-links">
            <p>Already have an account? <a href="/login/">Sign in</a></p>
          </div>
        </section>
      </div>
    </main>

    {% include "identity-importmap.njk" %}
    <script type="module" src="/js/auth-client.js"></script>
  </body>
</html>
